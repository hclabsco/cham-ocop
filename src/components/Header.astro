---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Chấm điểm", short: "Chấm", active: path === "/" || path.startsWith("/cham/") },
  { href: "/han-giay-chung-nhan/", label: "Hạn giấy chứng nhận", short: "Hạn giấy", active: path.startsWith("/han-giay-chung-nhan/") },
  { href: "/nguon/", label: "Nguồn & cách tính", short: "Nguồn", active: path.startsWith("/nguon/") },
];
---

<header class="no-print border-b border-line bg-bg/95 backdrop-blur sticky top-0 z-40">
  <div class="page flex items-center justify-between gap-4 h-16">
    <a href="/" class="flex items-center gap-2.5 no-underline text-ink" aria-label="Chấm OCOP, trang chủ">
      <img src="/brand/logo-mark-light.svg" alt="" width="28" height="28" />
      <span class="font-bold text-[17px] tracking-tight whitespace-nowrap">Chấm OCOP</span>
      <span class="hidden sm:inline text-muted text-sm">by HC Labs</span>
    </a>
    <nav aria-label="Chính">
      <ul class="flex items-center gap-1 sm:gap-2 list-none m-0 p-0 text-[14px] sm:text-[15px]">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={l.active ? "page" : undefined}
                class:list={[
                  "px-2 sm:px-3 py-2 rounded-[8px] no-underline font-medium whitespace-nowrap",
                  l.active ? "text-ink bg-bg-warm" : "text-ink-soft hover:text-ink",
                ]}
              >
                <span class="sm:hidden">{l.short}</span>
                <span class="hidden sm:inline">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
