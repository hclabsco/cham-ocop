/**
 * Assets-only Worker: Cloudflare serves ./dist directly, no Worker code runs.
 * Hostname ocop.hclabs.co is attached in the infra repo (OpenTofu), not here.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cham-ocop",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
